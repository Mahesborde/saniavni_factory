OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Use the Supabase project URL and secret key on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Supabase Postgres connection URI used by the dashboard and as migration destination.
# Copy the current URI from Supabase Connect; URL-encode reserved password characters.
DATABASE_URL=
# Legacy alternative, if your project has not created an sb_secret key:
# SUPABASE_SERVICE_ROLE_KEY=

# Source PostgreSQL connection for local fallback and farmer-data migration.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=require
